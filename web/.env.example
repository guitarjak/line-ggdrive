# ============================================
# LINEFILESAVER WEB APP - Environment Variables
# ============================================

# ------------------
# Supabase Configuration
# ------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ------------------
# Backend API
# ------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
# Production: https://api.linefilesaver.com

# ------------------
# Application Settings
# ------------------
NEXT_PUBLIC_APP_NAME=LineFileSaver
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Production: https://linefilesaver.com

# ------------------
# Features (Optional)
# ------------------
# Enable/disable features
NEXT_PUBLIC_ENABLE_SIGNUP=true
NEXT_PUBLIC_ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=false

# ------------------
# Billing (Optional - Stripe)
# ------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------
# Analytics (Optional)
# ------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_...

# ------------------
# Email (Optional)
# ------------------
# EMAIL_FROM=noreply@linefilesaver.com
# RESEND_API_KEY=re_...
