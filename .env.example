# ============================================
# LINE BOT FILE SEARCH - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ------------------
# Server Configuration
# ------------------
PORT=3000
NODE_ENV=production

# ------------------
# LINE Bot Settings
# ------------------
# Get these from LINE Developers Console: https://developers.line.biz/console/
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# ------------------
# Supabase Database
# ------------------
# Get these from Supabase Project Settings: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Database URL (Connection String - URI format)
# Get from: Project Settings > Database > Connection String > URI
# Replace [YOUR-PASSWORD] with your database password
SUPABASE_DB_URL=postgres://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ------------------
# Redis (Upstash)
# ------------------
# Get these from Upstash Console: https://console.upstash.com/
UPSTASH_REDIS_URL=redis://your-redis-url:6379
UPSTASH_REDIS_TOKEN=your_redis_token_here

# ------------------
# Google Drive API
# ------------------
# Create a service account: https://console.cloud.google.com/
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your_root_folder_id_here

# ------------------
# OpenAI API
# ------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_api_key_here

# ------------------
# Pinecone Vector Database
# ------------------
# Get from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=line-files

# ------------------
# Optional: Monitoring & Analytics
# ------------------
# Sentry for error tracking (optional)
# SENTRY_DSN=your_sentry_dsn_here

# ------------------
# Bot Configuration
# ------------------
# Maximum file size to process (in bytes, default: 50MB)
MAX_FILE_SIZE=52428800

# Supported file types (comma-separated)
SUPPORTED_FILE_TYPES=image,video,audio,file

# Admin user IDs (comma-separated LINE user IDs)
ADMIN_USER_IDS=U1234567890abcdef

# Default language for bot responses
BOT_LANGUAGE=th
